{
  "info": {
    "_postman_id": "8a2c6d10-1111-4f00-9b00-000000000000",
    "name": "Mottu - Desafio Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção alinhada ao Swagger oficial: /motos, /entregadores e /locacao com payloads snake_case."
  },
  "item": [
    {
      "name": "Motos",
      "item": [
        {
          "name": "Cadastrar moto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"moto123\",\n  \"ano\": 2024,\n  \"modelo\": \"Mottu Sport\",\n  \"placa\": \"CDX-0101\"\n}"
            },
            "url": { "raw": "{{url}}/motos", "host": ["{{url}}"], "path": ["motos"] }
          }
        },
        {
          "name": "Consultar motos (filtro placa)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{url}}/motos?placa=CDX-0101",
              "host": ["{{url}}"],
              "path": ["motos"],
              "query": [{ "key": "placa", "value": "CDX-0101" }]
            }
          }
        },
        {
          "name": "Consultar moto por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{url}}/motos/moto123", "host": ["{{url}}"], "path": ["motos", "moto123"] }
          }
        },
        {
          "name": "Modificar placa",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"placa\": \"ABC-1234\"\n}" },
            "url": { "raw": "{{url}}/motos/moto123/placa", "host": ["{{url}}"], "path": ["motos", "moto123", "placa"] }
          }
        },
        {
          "name": "Remover moto",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{url}}/motos/moto123", "host": ["{{url}}"], "path": ["motos", "moto123"] }
          }
        }
      ]
    },
    {
      "name": "Entregadores",
      "item": [
        {
          "name": "Cadastrar entregador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"entregador123\",\n  \"nome\": \"João Entregador\",\n  \"cnpj\": \"12345678000195\",\n  \"data_nascimento\": \"1990-01-01\",\n  \"numero_cnh\": \"77058710884\",\n  \"tipo_cnh\": \"A\",\n  \"imagem_cnh\": null\n}"
            },
            "url": { "raw": "{{url}}/entregadores", "host": ["{{url}}"], "path": ["entregadores"] }
          }
        },
        {
          "name": "Enviar foto da CNH",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imagem_cnh\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkAAIAAAoAAv/lxKUAAAAASUVORK5CYII=\"\n}"
            },
            "url": {
              "raw": "{{url}}/entregadores/entregador123/cnh",
              "host": ["{{url}}"],
              "path": ["entregadores", "entregador123", "cnh"]
            }
          }
        }
      ]
    },
    {
      "name": "Locação",
      "item": [
        {
          "name": "Alugar moto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"locacao123\",\n  \"entregador_id\": \"entregador123\",\n  \"moto_id\": \"moto123\",\n  \"data_inicio\": \"2026-05-01T00:00:00Z\",\n  \"data_termino\": \"2026-05-08T00:00:00Z\",\n  \"data_previsao_termino\": \"2026-05-08T00:00:00Z\",\n  \"plano\": 7\n}"
            },
            "url": { "raw": "{{url}}/locacao", "host": ["{{url}}"], "path": ["locacao"] }
          }
        },
        {
          "name": "Consultar locação por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{url}}/locacao/locacao123", "host": ["{{url}}"], "path": ["locacao", "locacao123"] }
          }
        },
        {
          "name": "Informar devolução",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"data_devolucao\": \"2026-05-08T00:00:00Z\"\n}" },
            "url": {
              "raw": "{{url}}/locacao/locacao123/devolucao",
              "host": ["{{url}}"],
              "path": ["locacao", "locacao123", "devolucao"]
            }
          }
        }
      ]
    },
    {
      "name": "Manager (legado)",
      "item": [
        {
          "name": "Authentication",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token capturado', function() {",
                  "    var json = pm.response.json();",
                  "    if (json && json.token) pm.environment.set('token', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"job@job.com\",\n  \"password\": \"mudar@123\"\n}" },
            "url": {
              "raw": "{{url}}/manager/authentication",
              "host": ["{{url}}"],
              "path": ["manager", "authentication"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "url", "value": "http://localhost:5001" }
  ]
}
